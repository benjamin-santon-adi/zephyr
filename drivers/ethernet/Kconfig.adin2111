menuconfig ETH_ADIN2111
	bool "ADIN2111 2-port 10BASE-T1L Controller"
	default y
	depends on DT_HAS_ADI_ADIN2111_ENABLED || DT_HAS_ADI_ADIN1110_ENABLED
	select ETH_PHY_DRIVER
	select SPI
	imply CRC
	help
	  The ADIN2111 is a low power, 2-port 10BASE-T1L transceiver
	  designed for industrial Ethernet applications, and is compliant with
	  the IEEE® 802.3cg-2019™ Ethernet standard for long reach, 10
	  Mbps single pair Ethernet (SPE).

	  Featuring an integrated media access control (MAC) and a switch,
	  the ADIN2111 enables direct connectivity with a variety of controllers
	  via a serial peripheral inter-face (SPI).

if ETH_ADIN2111

config ETH_ADIN2111_IRQ_THREAD_STACK_SIZE
	int "Stack size for a thread that processes ADIN IRQ"
	default 2048
	help
	  Size of the stack used for internal thread which is ran to
	  process raised INT IRQ.

config ETH_ADIN2111_IRQ_THREAD_PRIO
	int "Priority for internal incoming packet handler"
	default 2
	help
	  Priority level for internal thread which is ran for ADIN
	  INT IRQ processing.

config ETH_ADIN2111_TIMEOUT
	int "IP buffer timeout"
	default 100
	help
	  Given timeout in milliseconds. Maximum amount of time
	  that the driver will wait from the IP stack to get
	  a memory buffer before the Ethernet frame is dropped.

config ETH_ADIN2111_SPI_CFG0
	bool "SPI_CFG0"
	default y
	help
	  Must be set when ADIN uses 8-bit CRC (Generic SPI)
	  or Protection Mode (OPEN Alliance) on the SPI Host Interface.

config ETH_ADIN2111_BUFFER_SIZE
	int "Buffer size in bytes use for frame transmission"
	default 1524
	help
	  Transmission and reception buffer size.

config ETH_ADIN2111_SWITCH_IFACE
	bool "Switch interface for the IP traffic of the ADIN2111"
	default y
	depends on DT_HAS_ADI_ADIN2111_ENABLED
	help
	  Support a third network interface on an ADIN2111, next to the two port
	  interfaces. The interface is created for each ADIN2111 devicetree node
	  that has a "switch" child with status "okay" and a local-mac-address.

	  The switch interface owns the MAC and IP addresses of the device, and
	  carries the IP traffic of both ports: a frame it sends leaves by the
	  port of its destination, and the frames received from both ports for
	  the host arrive on it.

	  The port interfaces keep the frames of the link-local protocols such as
	  LLDP, gPTP and STP, and cannot carry IP. The ADIN2111 forwards the
	  frames between its two ports in hardware, the host takes no part in it.

	  Disable it to leave the code out when no node uses it.

config ETH_ADIN2111_SWITCH_FDB_SIZE
	int "Number of stations the switch interface remembers"
	default 8
	range 1 64
	depends on ETH_ADIN2111_SWITCH_IFACE
	help
	  The ADIN2111 cannot choose the egress port of a frame the host sends.
	  The switch interface learns the port of a station from the frames it
	  receives from it, and sends to a station it does not know on both ports.

config ETH_ADIN2111_SWITCH_FDB_AGEING_TIME
	int "Seconds before the switch interface forgets a station"
	default 300
	range 1 86400
	depends on ETH_ADIN2111_SWITCH_IFACE

endif # ETH_ADIN2111
